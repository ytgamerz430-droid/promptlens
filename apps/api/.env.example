# Environment template — copy to .env and fill in
# Never commit a real .env.

# --- Server ---
PORT=4000
WEB_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# SQLite file path (default: ./data/app.db)
DATABASE_PATH=./data/app.db

# --- Auth / OAuth (optional) ---
# Google OAuth for "Continue with Google". Leave unset to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Email (optional) ---
# Used for password-reset links. If unset, reset tokens are logged to console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- AI providers (server defaults; users can also bring their own keys in Settings) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-90b-vision-preview
MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-12b-2409
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Use "mock" to run tools without any provider key (dev only — clearly labeled in UI).
DEFAULT_PROVIDER=mock

# --- Credits ---
SIGNUP_CREDITS=5
DAILY_FREE_CREDITS=5

# --- Uploads ---
MAX_UPLOAD_MB=100
UPLOAD_DIR=./data/uploads

# --- Adobe Stock tracker (optional) ---
ADOBE_STOCK_API_KEY=
